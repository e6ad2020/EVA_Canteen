{
  "name": "eva-canteen",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "start:web-flutter": "npm run build:flutter && node server.js --web-flutter",
    "serve:web-flutter": "node server.js --web-flutter",
    "start:old-web": "node server.js --old-web",
    "old-web": "node server.js --old-web",
    "check": "node --check server.js && node --check script.js && node --check database.js && node --check password_hash.js && node --check db_cli.js && node --check hash_tool.js",
    "verify": "node verification/verify_backend_v1_1.js",
    "build:flutter": "cd flutter_app && flutter build web --wasm --no-web-resources-cdn",
    "build:android": "cd flutter_app && flutter build apk --release --target-platform android-arm64 --split-per-abi",
    "test:flutter": "cd flutter_app && flutter test && flutter analyze",
    "db:cli": "node db_cli.js",
    "hash": "node hash_tool.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "open": "^11.0.0",
    "selfsigned": "^2.4.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "optionalDependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2"
  }
}
